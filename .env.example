NODE_ENV=production
PORT=3000

# Base PostgreSQL partagée du VPS, schéma dédié wedding_music
DATABASE_URL=postgresql://wedding_music_app:CHANGE_ME@postgres:5432/apps?schema=wedding_music

SESSION_COOKIE_NAME=wedding_session
SESSION_TTL_HOURS=12
COOKIE_SECURE=true
TRUST_PROXY=1

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN
USER_USERNAME=user
USER_PASSWORD=CHANGE_ME_USER

MEDIA_ROOT=/app/data/media
UPLOAD_TMP_DIR=/app/data/tmp

# Image publiée par GitHub Actions
GHCR_OWNER=change-me
GHCR_REPOSITORY=regie-mariage
