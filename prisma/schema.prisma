generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["wedding_music"]
}

enum Role {
  ADMIN
  USER

  @@schema("wedding_music")
}

enum AssetKind {
  AUDIO
  IMAGE

  @@schema("wedding_music")
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  username     String        @unique @db.VarChar(80)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  role         Role
  sessions     UserSession[]
  scripts      CeremonyScript[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("users")
  @@schema("wedding_music")
}

model UserSession {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
  @@schema("wedding_music")
}

model Category {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @unique @db.VarChar(100)
  sortOrder Int           @default(0) @map("sort_order")
  buttons   MusicButton[]
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("categories")
  @@schema("wedding_music")
}

model MediaAsset {
  id           String        @id @default(uuid()) @db.Uuid
  kind         AssetKind
  sha256       String        @db.Char(64)
  originalName String        @map("original_name") @db.VarChar(255)
  mimeType     String        @map("mime_type") @db.VarChar(120)
  sizeBytes    BigInt        @map("size_bytes")
  storagePath  String        @map("storage_path") @db.VarChar(500)
  audioButtons MusicButton[] @relation("ButtonAudio")
  imageButtons MusicButton[] @relation("ButtonImage")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@unique([kind, sha256])
  @@map("media_assets")
  @@schema("wedding_music")
}

model MusicButton {
  id           String      @id @default(uuid()) @db.Uuid
  name         String      @db.VarChar(120)
  tag          String      @unique @db.VarChar(80)
  description  String      @default("") @db.VarChar(300)
  sortOrder    Int         @default(0) @map("sort_order")
  categoryId   String      @map("category_id") @db.Uuid
  category     Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  audioAssetId String      @map("audio_asset_id") @db.Uuid
  audioAsset   MediaAsset  @relation("ButtonAudio", fields: [audioAssetId], references: [id], onDelete: Restrict)
  imageAssetId String?     @map("image_asset_id") @db.Uuid
  imageAsset   MediaAsset? @relation("ButtonImage", fields: [imageAssetId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([categoryId, sortOrder])
  @@map("music_buttons")
  @@schema("wedding_music")
}

model CeremonyScript {
  id          String   @id @db.VarChar(30)
  content     String   @default("") @db.Text
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("ceremony_scripts")
  @@schema("wedding_music")
}
